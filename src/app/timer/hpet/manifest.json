{
    "$schema": "https://schemas.cute.engineering/stable/cutekit.manifest.component.v1",
    "id": "wingos-clock",
    "type": "exe",
    "description": "HPET (x86) server time implementation",

    "props": {
      "exported": "disk",
        "pkgname": "wingos-clock"
    },
    "requires": [
        "libcore",
        "hw-hpet"
    ],
    "enableIf": {
        "sys": [
            "wingos"
        ]
    }
}
